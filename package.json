{
  "name": "trackball",
  "version": "1.0.0",
  "description": "AI Sports Analysis Platform - Professional video analysis for semi-professional teams",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "concurrently \"nx serve api\" \"nx serve web\"",
    "build": "nx run-many --target=build --projects=web,api",
    "test": "nx run-many --target=test --projects=web,api",
    "test:e2e": "nx e2e web-e2e",
    "lint": "nx run-many --target=lint --projects=web,api",
    "format": "prettier --write .",
    "typecheck": "nx run-many --target=typecheck --projects=web,api",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "infra:deploy": "cd infrastructure/aws-cdk && cdk deploy --all",
    "infra:destroy": "cd infrastructure/aws-cdk && cdk destroy --all",
    "db:migrate": "cd apps/api && alembic upgrade head",
    "db:rollback": "cd apps/api && alembic downgrade -1"
  },
  "keywords": [
    "video-analysis",
    "sports",
    "ai",
    "tracking",
    "react",
    "fastapi",
    "nx"
  ],
  "author": "Trackball Team",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@nx/eslint": "21.3.5",
    "@nx/js": "21.3.5",
    "@nx/node": "21.3.5",
    "@nx/react": "21.3.5",
    "@nx/vite": "21.3.5",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.52.0",
    "husky": "^8.0.3",
    "nx": "21.3.5",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  }
}
