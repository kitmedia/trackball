{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@trackball/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@trackball/ui-components": ["../../libs/ui-components/src/index.ts"],
      "@trackball/api-client": ["../../libs/api-client/src/index.ts"]
    }
  },
  "include": ["src", "../../libs/shared-types/src", "../../libs/ui-components/src", "../../libs/api-client/src"],
  "exclude": ["node_modules", "dist", "build"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}