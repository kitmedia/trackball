    "@mui/x-date-pickers": "^6.18.1",
    "@tanstack/react-query": "^4.36.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.17.0",
    "zustand": "^4.4.4",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "react-player": "^2.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
